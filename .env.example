# Copy to backend/.env to override defaults.
# Research stays off until both API keys are set. Do not commit the filled-in file.

DATABASE_URL=sqlite:///./data/guides.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_STARTUP=true

# openai, anthropic, backboard, or gemma. Any other value leaves research off.
# MODEL_NAME overrides the provider default.
# openai default: gpt-4o-mini. anthropic default: claude-sonnet-4-5. gemma default: gemma-4-26b-a4b-it.
# backboard uses one Backboard key (X-API-Key) and BACKBOARD_LLM_PROVIDER to pick the upstream.
# openai upstream defaults to gpt-4.1. google upstream defaults to gemma-4-26b-a4b-it.
MODEL_PROVIDER=openai
MODEL_API_KEY=
MODEL_NAME=
# BACKBOARD_LLM_PROVIDER=openai

# tavily or brave. Any other value leaves research off.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# Optional limits.
# PAGE_TIMEOUT_SECONDS=10
# PAGE_MAX_BYTES=1200000
# MAX_RESEARCH_PAGES=4
# MAX_SEARCH_RESULTS=5
# MODEL_TIMEOUT_SECONDS=45
# SEARCH_TIMEOUT_SECONDS=10
# RESEARCH_DEADLINE_SECONDS=90
# RESEARCH_INLINE=false
