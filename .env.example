# Copy to backend/.env to override defaults.
# Research stays off until both API keys are set. Do not commit the filled-in file.

DATABASE_URL=sqlite:///./data/guides.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_STARTUP=true

# openai or anthropic. MODEL_NAME overrides the provider default.
MODEL_PROVIDER=openai
MODEL_API_KEY=
MODEL_NAME=

# tavily or brave.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# Optional limits.
# PAGE_TIMEOUT_SECONDS=10
# PAGE_MAX_BYTES=500000
# MAX_RESEARCH_PAGES=4
# MAX_SEARCH_RESULTS=5
# MODEL_TIMEOUT_SECONDS=45
# SEARCH_TIMEOUT_SECONDS=10
# RESEARCH_DEADLINE_SECONDS=90
# RESEARCH_INLINE=false
